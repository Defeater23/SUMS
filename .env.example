# ---------------------------------------------------------------------------
# SUMS environment configuration
# Copy this file to `.env` and fill in the values from your Supabase project.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put the service-role key in a VITE_ variable.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe for the browser (RLS still applies).
VITE_SUPABASE_ANON_KEY=

# Supabase project reference id (used by the CLI, not the browser).
# SUPABASE_PROJECT_ID=

# --- Server-side only (used by scripts and Edge Functions, never the browser) ---
# Service-role key. Bypasses RLS. Keep secret. Only used by local seeding scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: secret for verifying inbound Edge Function calls (booking emails).
# BOOKING_NOTIFY_WEBHOOK_SECRET=

# Optional: e-mail delivery provider for the optional Edge Function.
# RESEND_API_KEY=
# BOOKING_NOTIFY_FROM=no-reply@example.edu
